  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && esbuild src/server/vercelEntry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
