{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "redirects": [
    { "source": "/data/questions.json", "destination": "/api/questions", "statusCode": 307 },
    { "source": "/.env", "destination": "/404", "statusCode": 404 },
    { "source": "/.env.local", "destination": "/404", "statusCode": 404 },
    { "source": "/.git/:path*", "destination": "/404", "statusCode": 404 }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!data/).*)",
      "destination": "/index.html"
    }
  ]
}